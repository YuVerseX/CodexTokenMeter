<Window x:Class="CodexTokenMeter.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Token Meter"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <!--
       不使用 SizeToContent。

       SizeToContent 与 LayoutTransform 缩放、DropShadowEffect 叠加时，
       测量宽度会小于实际渲染宽度（实测内容右侧被窗口边缘裁掉 0-4 像素）。
       改为由代码显式计算并设置窗口尺寸，测量与布局结果可直接校验。
    -->

    <Window.Resources>

        <!-- 分隔线：极细，仅用于分组，不做框线 -->
        <Style x:Key="HairlineStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBorderBrush}" />
        </Style>

        <!-- 分组标题 -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource LabelFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <!-- 指标标签 -->
        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource LabelFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 指标数值：等宽右对齐，避免位数变化时抖动 -->
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource NumericFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeValue}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
           双列指标网格。

           每列都是「标签 + 右对齐数值」，且两列的数值边界在竖向对齐：
           左列数值固定宽 92、右列数值固定宽 74。
           不用 Width="*"：那会按各行内容自行分配宽度，
           导致不同行的数值列右边界错位，读数时需重新定位。
        -->
        <Style x:Key="MetricRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <!-- 左列数值：容纳 12,345,678 这类完整数字 -->
        <Style x:Key="MetricValueLeftStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricValueStyle}">
            <Setter Property="MinWidth" Value="96" />
        </Style>

        <!-- 右列数值：位数通常更少 -->
        <Style x:Key="MetricValueRightStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricValueStyle}">
            <Setter Property="MinWidth" Value="76" />
        </Style>

    </Window.Resources>

    <!--
        外层留出阴影空间。数值必须与 OverlayWindow.ShadowLeft/Top/Right/Bottom
        一致：窗口尺寸由代码测量 RootPanel 后加上这些预留得出。
        右侧多留 4 像素以容纳亚像素误差。
    -->
    <Grid Margin="16,16,20,16">
        <StackPanel x:Name="RootPanel"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left">

            <!-- ═══════════ 胶囊态 ═══════════ -->
            <Border x:Name="CapsuleBorder"
                    CornerRadius="{DynamicResource CapsuleCornerRadius}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    Padding="15,9"
                    Cursor="SizeAll"
                    Effect="{DynamicResource OverlayShadow}"
                    MouseLeftButtonDown="OnCapsuleMouseDown"
                    MouseMove="OnCapsuleMouseMove"
                    MouseLeftButtonUp="OnCapsuleMouseUp"
                    LostMouseCapture="OnCapsuleLostMouseCapture">
                <StackPanel x:Name="CapsuleContent"
                            Orientation="Horizontal"
                            VerticalAlignment="Center" />
            </Border>

            <!-- ═══════════ 展开态 ═══════════ -->
            <Border x:Name="PanelBorder"
                    Margin="0,9,0,0"
                    CornerRadius="{DynamicResource PanelCornerRadius}"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    Padding="17,15,17,15"
                    Effect="{DynamicResource PanelShadow}"
                    Visibility="Collapsed">
                <StackPanel Width="298">

                    <!-- ─── 头部：项目与模型 ─── -->
                    <TextBlock x:Name="ProjectLabel"
                               Text="—"
                               FontFamily="{DynamicResource LabelFont}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <!-- 模型做成小胶囊，与普通文本区分 -->
                        <Border CornerRadius="{DynamicResource ChipCornerRadius}"
                                Background="{DynamicResource AccentSoftBrush}"
                                Padding="7,2.5,7,2.5"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ModelLabel"
                                       Text="—"
                                       FontFamily="{DynamicResource NumericFont}"
                                       FontSize="10"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>

                        <TextBlock x:Name="DurationLabel"
                                   Text=""
                                   Margin="8,0,0,0"
                                   FontFamily="{DynamicResource NumericFont}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- ─── 主角：本轮费用 ─── -->
                    <Border Margin="0,14,0,0"
                            CornerRadius="12"
                            Background="{DynamicResource SurfaceSunkenBrush}"
                            Padding="13,11,13,11">
                        <StackPanel>
                            <TextBlock x:Name="CurrentTurnHeader"
                                       Text="本轮花费"
                                       FontFamily="{DynamicResource LabelFont}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock x:Name="TurnCost"
                                       Text="—"
                                       Margin="0,4,0,0"
                                       FontFamily="{DynamicResource NumericFont}"
                                       FontSize="{DynamicResource FontSizeHero}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource CostBrush}" />
                            <TextBlock x:Name="TurnSummary"
                                       Text="—"
                                       Margin="0,4,0,0"
                                       FontFamily="{DynamicResource LabelFont}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- ─── 上下文占用 ─── -->
                    <Grid Margin="0,14,0,0">
                        <TextBlock Text="上下文"
                                   Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock x:Name="ContextDetail"
                                   Text="—"
                                   Style="{StaticResource MetricValueStyle}" />
                    </Grid>
                    <Border Height="4"
                            CornerRadius="2"
                            Margin="0,7,0,0"
                            Background="{DynamicResource TrackBrush}">
                        <Border x:Name="ContextBarFill"
                                HorizontalAlignment="Left"
                                Width="0"
                                Height="4"
                                CornerRadius="2"
                                Background="{DynamicResource AccentBrush}" />
                    </Border>

                    <!-- ─── 本轮明细 ─── -->
                    <Border Style="{StaticResource HairlineStyle}" Margin="0,14,0,12" />

                    <TextBlock x:Name="CurrentTurnSectionLabel"
                               Text="本轮"
                               Style="{StaticResource SectionLabelStyle}" />

                    <Grid Style="{StaticResource MetricRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="输入" Style="{StaticResource MetricLabelStyle}" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" x:Name="TurnInput" Style="{StaticResource MetricValueLeftStyle}" />
                        <TextBlock Grid.Column="3" Text="输出" Style="{StaticResource MetricLabelStyle}" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="4" x:Name="TurnOutput" Style="{StaticResource MetricValueRightStyle}" />
                    </Grid>

                    <!-- ─── 会话累计 ─── -->
                    <Border Style="{StaticResource HairlineStyle}" Margin="0,13,0,13" />

                    <TextBlock x:Name="TotalHeader" Text="会话累计" Style="{StaticResource SectionLabelStyle}" />

                    <Grid Style="{StaticResource MetricRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="输入" Style="{StaticResource MetricLabelStyle}" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" x:Name="TotalInput" Style="{StaticResource MetricValueLeftStyle}" />
                        <TextBlock Grid.Column="3" Text="输出" Style="{StaticResource MetricLabelStyle}" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="4" x:Name="TotalOutput" Style="{StaticResource MetricValueRightStyle}" />
                    </Grid>

                    <Grid Style="{StaticResource MetricRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="缓存读" Style="{StaticResource MetricLabelStyle}" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" x:Name="TotalCacheRead" Style="{StaticResource MetricValueLeftStyle}" />
                        <TextBlock Grid.Column="3" Text="总计" Style="{StaticResource MetricLabelStyle}" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="4" x:Name="TotalTokens" Style="{StaticResource MetricValueRightStyle}" />
                    </Grid>

                    <Grid Style="{StaticResource MetricRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="费用" Style="{StaticResource MetricLabelStyle}" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" x:Name="TotalCost"
                                   Style="{StaticResource MetricValueLeftStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource CostBrush}" />
                        <TextBlock Grid.Column="3" Text="命中率" Style="{StaticResource MetricLabelStyle}" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="4" x:Name="CacheHitRate" Style="{StaticResource MetricValueRightStyle}" />
                    </Grid>

                    <!-- ─── 消息与工具 ─── -->
                    <Border Style="{StaticResource HairlineStyle}" Margin="0,13,0,13" />

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="消息" Style="{StaticResource MetricLabelStyle}" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" x:Name="MessageDetail"
                                   Text="—"
                                   Style="{StaticResource MetricValueLeftStyle}" />
                        <TextBlock Grid.Column="3" Text="工具" Style="{StaticResource MetricLabelStyle}" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="4" x:Name="ToolDetail" Style="{StaticResource MetricValueRightStyle}" />
                    </Grid>

                    <!-- ─── 提示区 ─── -->
                    <TextBlock x:Name="NoticeLabel"
                               Margin="0,12,0,0"
                               FontFamily="{DynamicResource LabelFont}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource CostWarnBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
